# Non-secret example only. Never add provider credentials to PUBLIC_* variables.
# Vercel supplies VERCEL=1 and VERCEL_ENV=production on production builds.
# Development, local hosts and preview deployments never run optional tracking.

# Vercel custom events require an independently confirmed supported plan.
# Still requires analytics permission and a safe URL/referrer context.
PUBLIC_ENABLE_CUSTOM_EVENTS=false

# Email and SMS enrollment are NOT enabled by environment variables.
# See src/data/business.ts and docs/contact-permissions.md for separate gates.
