---
import { business, marketingAvailability } from '../data/business';
import { contactPermissionAvailability } from '../data/contact-permissions';

const available = contactPermissionAvailability(marketingAvailability);
---
<section id="contact" class="wrap sec">
  <div class="[display:grid] [grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr))] [gap:clamp(40px,6vw,96px)] [align-items:start]">
    <div data-reveal class="[display:flex] [flex-direction:column] [gap:24px]">
      <div class="eyebrow">Contact</div>
      <h2 class="h2">Let's talk about your business 👋</h2>
      <p class="lead [max-width:440px]">Tell us what you need and we'll get back to you with next steps. No pressure, no jargon.</p>
      <a href={`mailto:${business.email}`} style="background:#fff" class="[margin-top:8px] [display:flex] [align-items:center] [gap:14px] [padding:14px] [border-radius:16px] [border:1px_solid_rgba(11,27,58,.06)] [text-decoration:none] [color:#0B1B3A]"><span style="background:#F6339A" class="[width:44px] [height:44px] [border-radius:12px] [display:grid] [place-items:center]"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/></svg></span><span class="[display:flex] [flex-direction:column] [gap:5px]"><span class="[font-size:13px] [line-height:1] [font-weight:600] [color:#4A5675]">Email</span><strong class="[font-size:17px] [line-height:1]">{business.email}</strong></span></a>
    </div>
    <div id="contact-form" data-reveal style="background:#fff" class="[border-radius:28px] [border:1px_solid_rgba(11,27,58,.06)] [box-shadow:0_40px_80px_-50px_rgba(11,27,58,.4)] [padding:clamp(24px,3.5vw,40px)]">
      <noscript><p class="lead">Please use the email link to send your request. The form requires JavaScript.</p></noscript>
      <form id="form" data-js-only class="[display:flex] [flex-direction:column] [gap:18px]">
        <div class="[display:grid] [grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr))] [gap:14px]">
          <label class="field"><span>Your name <span class="req">*</span></span><input required name="name" placeholder="John Doe" autocomplete="name"></label>
          <label class="field">Business name<input name="business" placeholder="Smith Plumbing" autocomplete="organization"></label>
          <label class="field"><span>Email <span class="req">*</span></span><input required type="email" name="email" placeholder="you@gmail.com" autocomplete="email"></label>
          <label class="field">Phone<input type="tel" name="phone" placeholder="Optional" autocomplete="tel" aria-describedby="phone-hint permissionError"></label>
        </div>
        <div id="needs" role="group" aria-labelledby="needs-label" aria-describedby="needError" class="[display:flex] [flex-direction:column] [gap:10px]">
          <span id="needs-label" class="[font-weight:700] [font-size:14px]">What do you need? <span class="req">*</span></span>
          <div class="[display:flex] [flex-wrap:wrap] [gap:8px]">
            <button type="button" class="need on" data-need="website" aria-pressed="true">Website</button>
            <button type="button" class="need" data-need="social" aria-pressed="false">Social media</button>
            <button type="button" class="need" data-need="email" aria-pressed="false">Email marketing</button>
            <button type="button" class="need" data-need="ads" aria-pressed="false">Ads</button>
          </div>
          <span id="needError" role="alert" hidden class="[font-size:13px] [font-weight:700] [color:#B0126B]">Pick at least one so we know where to start.</span>
        </div>
        <label class="field">Tell us a bit about your business<textarea name="message" rows="5" placeholder="What you do, where you work, what you'd like help with."></textarea></label>
        <p id="contact-privacy-notice" class="permission-copy">{business.brand} uses these details to respond to your inquiry. See our <a href="/privacy">Privacy &amp; Cookies notice</a>. Sending a request does not sign you up for marketing. No marketing permission or optional cookies are required to send an inquiry.</p>
        <fieldset class="marketing-permissions">
          <legend>Optional marketing permissions</legend>
          <div class="marketing-permission">
            <label><input type="checkbox" name="email_marketing" value="yes" disabled={!available.email} aria-describedby="email-marketing-status permissionError"><span>Email me the {business.brand} newsletter every two weeks and commercial offers. I can unsubscribe at any time.</span></label>
            <p id="email-marketing-status" class="permission-copy">{available.email ? 'Optional. This choice is separate from SMS marketing and your inquiry.' : 'Unavailable: we have not verified email consent storage and unsubscribe handling. You can still send your inquiry without subscribing.'}</p>
          </div>
          <div class="marketing-permission">
            <label><input type="checkbox" name="sms_marketing" value="yes" disabled={!available.sms} aria-describedby="sms-marketing-status phone-hint sms-marketing-terms permissionError"><span>Send me automated marketing SMS from {business.brand} via Brevo. Consent is optional and is not a condition of purchase.</span></label>
            <p id="sms-marketing-terms" class="permission-copy">Planned program: message frequency would vary and message and data rates may apply. STOP opt-out and HELP instructions must be configured before launch; no program number is available now. SMS only, not calls or WhatsApp. Brevo is the proposed delivery provider, not a separate marketing permission. See <a href="/sms-terms">SMS Terms</a> and our <a href="/privacy">Privacy &amp; Cookies notice</a>.</p>
            <p id="phone-hint" class="permission-copy">Phone is optional for inquiries. SMS, when available, requires an international number such as +14155552671.</p>
            <p id="sms-marketing-status" class="permission-copy">{available.sms ? 'Optional. This choice is separate from email marketing and your inquiry.' : 'Unavailable: we have not verified SMS consent storage and Brevo sending and opt-out setup. You can still send your inquiry without subscribing.'}</p>
          </div>
        </fieldset>
        <p id="permissionError" role="alert" tabindex="-1" hidden class="[margin:0] [font-size:14px] [color:#B0126B]"></p>
        <button type="submit" class="btn btn-p [justify-content:center] [box-shadow:none]">Send request</button>
        <p id="submitError" role="alert" hidden class="[margin:0] [font-size:14px] [color:#B0126B]">We couldn’t confirm your submission. Your details are still here. Try again, or <a href={`mailto:${business.email}`}>email us directly</a>.</p>
        <span class="[font-size:13px] [line-height:1.4] [color:#4A5675]">We reply in less than 24 hours.</span>
      </form>
      <div id="sent" hidden class="[min-height:380px] [flex-direction:column] [align-items:flex-start] [justify-content:center] [gap:18px]">
        <span style="background:#00D3F2" class="[width:64px] [height:64px] [border-radius:18px] [display:grid] [place-items:center] [transform:rotate(-4deg)]"><span style="background:#0B1B3A" class="[width:18px] [height:18px] [border-radius:3px] [transform:rotate(45deg)]"></span></span>
        <h3 id="sent-heading" tabindex="-1" class="[margin:0] [font-weight:800] [font-size:36px] [line-height:1] [letter-spacing:-0.02em]">Request submitted.</h3>
        <p class="[margin:0] [font-size:17px] [line-height:1.4] [color:#3D4A68] [max-width:380px]">Your request has been received. If you don’t hear from us within 24 hours, <a href={`mailto:${business.email}`}>email us directly</a>.</p>
        <p class="permission-copy">This confirms your inquiry only. No email or SMS marketing subscription has been created.</p>
        <button type="button" id="again" style="background:#fff" class="[height:44px] [padding:0_18px] [border-radius:12px] [border:1.5px_solid_rgba(11,27,58,.14)] [font-weight:700] [font-size:15px] [cursor:pointer] [color:#0B1B3A]">Send another</button>
      </div>
    </div>
  </div>
</section>

<style>
  .marketing-permissions{margin:0;padding:18px;border:1px solid rgba(11,27,58,.14);border-radius:12px;min-width:0}
  .marketing-permissions legend{padding:0 6px;font-size:14px;font-weight:700}
  .marketing-permission + .marketing-permission{margin-top:18px;padding-top:18px;border-top:1px solid rgba(11,27,58,.1)}
  .marketing-permission label{display:flex;align-items:flex-start;gap:10px;font-size:14px;line-height:1.5}
  .marketing-permission input{flex:0 0 auto;width:18px;height:18px;margin:2px 0 0;accent-color:#155DFC}
  .marketing-permission input:focus-visible{outline:2px solid #155DFC;outline-offset:3px}
  .permission-copy{margin:0;font-size:13px;line-height:1.5;color:#4A5675}
  .marketing-permission .permission-copy{margin-top:8px}
</style>
