---
import { Image } from 'astro:assets';
import socialMediaBubble from '../../public/assets/social-media-bubble.png';
---

<section id="services" class="wrap sec">
  <div data-reveal class="[display:flex] [flex-wrap:wrap] [justify-content:space-between] [align-items:flex-end] [gap:24px] [margin-bottom:clamp(36px,4vw,56px)]">
    <div class="[display:flex] [flex-direction:column] [gap:18px] [max-width:720px]">
      <div class="eyebrow">Services</div>
      <h2 class="h2">Pick what you need. Skip the rest.</h2>
    </div>
    <p class="lead [max-width:380px]">Three ways to show up online. Use one, or let them all work together.</p>
  </div>
  <div class="[display:grid] [grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))] [gap:20px]">
    <a href="#websites" class="card" data-reveal>
      <div style="background:#155DFC" class="[aspect-ratio:16/10] [border-radius:20px] [display:grid] [place-items:center]">
        <div class="[display:grid] [grid-template-columns:44px_44px] [gap:8px]">
          <span style="background:#F5F7FB" class="[width:44px] [height:44px] [border-radius:10px]"></span><span style="background:#F5F7FB" class="[width:44px] [height:44px] [border-radius:10px]"></span><span style="background:#F5F7FB" class="[width:44px] [height:44px] [border-radius:10px]"></span>
          <span class="[width:44px] [height:44px] [display:grid] [place-items:center]"><span style="background:#F5F7FB" class="[width:32px] [height:32px] [border-radius:7px] [transform:rotate(45deg)]"></span></span>
        </div>
      </div>
      <div class="[padding:0_14px] [display:flex] [flex-direction:column] [gap:12px]">
        <h3>Websites</h3>
        <p>A site that turns visitors into calls and quote requests.</p>
        <span class="more">Explore websites<span class="dot [width:6px] [height:6px]"></span></span>
      </div>
    </a>
    <a href="#plans" data-tab="social" class="card" data-reveal>
      <div style="background:#F6339A" class="[aspect-ratio:16/10] [border-radius:20px] [display:grid] [place-items:center]">
        <Image src={socialMediaBubble} alt="" width={110} widths={[110, 220, 330]} sizes="110px" format="webp" loading="lazy" class="[width:110px] [height:auto] [aspect-ratio:551/480] [display:block]" />
      </div>
      <div class="[padding:0_14px] [display:flex] [flex-direction:column] [gap:12px]">
        <h3>Social media</h3>
        <p>Posts, reels and replies that keep your feed busy while you're on the job.</p>
        <span class="more">See social plans<span class="dot [width:6px] [height:6px]"></span></span>
      </div>
    </a>
    <a href="#plans" data-tab="email" class="card" data-reveal>
      <div style="background:#0B1B3A" class="[aspect-ratio:16/10] [border-radius:20px] [display:grid] [place-items:center]">
        <div style="background:#F5F7FB" class="[position:relative] [width:104px] [height:74px] [border-radius:12px] [overflow:hidden]">
          <span style="background:#0B1B3A" class="[position:absolute] [left:50%] [top:-46px] [width:72px] [height:72px] [margin-left:-36px] [border-radius:10px] [transform:rotate(45deg)]"></span>
          <span style="background:#F5F7FB" class="[position:absolute] [left:50%] [top:-52px] [width:72px] [height:72px] [margin-left:-36px] [border-radius:10px] [transform:rotate(45deg)]"></span>
        </div>
      </div>
      <div class="[padding:0_14px] [display:flex] [flex-direction:column] [gap:12px]">
        <h3>Email marketing</h3>
        <p>Campaigns that bring past customers back for the next job.</p>
        <span class="more">See email plans<span class="dot [width:6px] [height:6px]"></span></span>
      </div>
    </a>
  </div>
  <div data-reveal style="background:rgba(255,255,255,.6)" class="[margin-top:20px] [display:flex] [flex-wrap:wrap] [align-items:center] [justify-content:space-between] [gap:16px] [padding:20px_24px] [border-radius:20px] [border:1.5px_dashed_rgba(21,93,252,.35)]">
    <p class="[margin:0] [font-size:17px] [line-height:1.4] [font-weight:600]">📣 Want more reach? Paid ads on Instagram and Facebook can be added on top of any plan.</p>
    <a href="#addons" class="[font-weight:700] [font-size:16px] [color:#155DFC]">See ads pricing</a>
  </div>
</section>
