<section id="websites" class="wrap sec">
  <div class="[display:grid] [grid-template-columns:repeat(auto-fit,minmax(min(100%,500px),1fr))] [gap:clamp(48px,6vw,96px)] [align-items:center]">
    <div data-reveal class="[display:flex] [flex-direction:column] [gap:24px] [align-items:flex-start]">
      <div class="eyebrow">Websites</div>
      <h2 class="h2">A website built around <span class="hl" data-hl>your</span> business.</h2>
      <p class="lead [max-width:520px]">No template with your logo slapped on top. Your site is designed for your services, your area and the customers you want more of.</p>
      <div class="[display:grid] [grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr))] [gap:22px_28px] [width:100%] [margin:8px_0]">
        <div class="feat"><div><strong>Custom design</strong><span>Built around your brand, colors and services.</span></div></div>
        <div class="feat"><div><strong>Mobile-first layouts</strong><span>Most customers find you on their phone. Your site looks sharp there first.</span></div></div>
        <div class="feat"><div><strong>SEO setup</strong><span>The basics done right, so people nearby can find you.</span></div></div>
        <div class="feat"><div><strong>Leads straight to you</strong><span>Forms send every request directly to your inbox.</span></div></div>
      </div>
      <a href="#contact" class="btn btn-p" data-prefill="website">Request a quote<span class="dot"></span></a>
    </div>
    <div data-reveal aria-hidden="true" class="[position:relative] [padding:28px_0_40px]">
      <div style="background:#F6339A" class="[position:absolute] [top:-14px] [left:-8px] [z-index:2] [transform:rotate(-6deg)] [display:inline-flex] [align-items:center] [gap:8px] [padding:10px_16px] [color:#0B1B3A] [border-radius:12px] [font-weight:800] [font-size:16px] [line-height:1] [box-shadow:0_12px_24px_-12px_rgba(246,51,154,.8)]"><span class="dot [width:8px] [height:8px]"></span>Tailored to your needs</div>
      <div style="background:#fff" class="[border-radius:20px] [box-shadow:0_40px_80px_-40px_rgba(11,27,58,.45),_0_0_0_1px_rgba(11,27,58,.06)] [overflow:hidden]">
        <div style="background:#EEF2F9" class="[height:44px] [display:flex] [align-items:center] [gap:8px] [padding:0_16px] [border-bottom:1px_solid_rgba(11,27,58,.06)]">
          <span style="background:#F6339A" class="[width:11px] [height:11px] [border-radius:50%]"></span><span style="background:#00D3F2" class="[width:11px] [height:11px] [border-radius:50%]"></span><span style="background:#155DFC" class="[width:11px] [height:11px] [border-radius:50%]"></span>
          <span style="background:#fff" class="[margin-left:12px] [flex:1] [max-width:280px] [height:26px] [border-radius:8px] [display:flex] [align-items:center] [padding:0_12px] [font-size:12px] [font-weight:600] [color:#4A5675]">yourbusiness.com</span>
        </div>
        <div class="[padding:clamp(20px,3vw,32px)] [display:flex] [flex-direction:column] [gap:22px]">
          <div class="[display:flex] [justify-content:space-between] [align-items:center]"><span class="[font-weight:800] [font-size:15px]">Oakline Roofing</span><span class="[display:flex] [gap:14px]"><span style="background:#DCE3EF" class="[width:36px] [height:6px] [border-radius:3px]"></span><span style="background:#DCE3EF" class="[width:36px] [height:6px] [border-radius:3px]"></span><span style="background:#DCE3EF" class="[width:36px] [height:6px] [border-radius:3px]"></span></span></div>
          <div class="[display:grid] [grid-template-columns:1.1fr_1fr] [gap:20px] [align-items:center]">
            <div class="[display:flex] [flex-direction:column] [gap:14px]">
              <span class="[font-weight:800] [font-size:clamp(22px,2.4vw,32px)] [line-height:1] [letter-spacing:-0.02em]">Roof repairs done right, the first time.</span>
              <span style="background:#E6EBF4" class="[width:90%] [height:7px] [border-radius:4px]"></span>
              <span style="background:#E6EBF4" class="[width:70%] [height:7px] [border-radius:4px]"></span>
              <span style="background:#155DFC" class="[align-self:flex-start] [margin-top:4px] [padding:10px_14px] [border-radius:10px] [color:#fff] [font-weight:700] [font-size:13px] [line-height:1]">Get a free estimate</span>
            </div>
            <div class="[display:grid] [grid-template-columns:1fr_1fr] [gap:8px]">
              <span style="background:#155DFC" class="[aspect-ratio:1] [border-radius:12px]"></span><span style="background:#00D3F2" class="[aspect-ratio:1] [border-radius:12px]"></span><span style="background:#0B1B3A" class="[aspect-ratio:1] [border-radius:12px]"></span>
              <span class="[aspect-ratio:1] [display:grid] [place-items:center]"><span style="background:#F6339A" class="[width:62%] [aspect-ratio:1] [border-radius:8px] [transform:rotate(45deg)]"></span></span>
            </div>
          </div>
          <div class="[display:grid] [grid-template-columns:repeat(3,1fr)] [gap:10px]"><span style="background:#F5F7FB" class="[height:54px] [border-radius:12px]"></span><span style="background:#F5F7FB" class="[height:54px] [border-radius:12px]"></span><span style="background:#F5F7FB" class="[height:54px] [border-radius:12px]"></span></div>
        </div>
      </div>
      <div style="background:#fff" class="[position:absolute] [right:-6px] [bottom:0] [display:flex] [align-items:center] [gap:12px] [padding:14px_18px_14px_14px] [border-radius:16px] [box-shadow:0_24px_48px_-20px_rgba(11,27,58,.45),_0_0_0_1px_rgba(11,27,58,.05)] [transform:rotate(2deg)]">
        <span style="background:#155DFC" class="[width:40px] [height:40px] [border-radius:11px] [display:grid] [place-items:center]"><span class="[width:18px] [height:13px] [border:2.5px_solid_#fff] [border-radius:3px]"></span></span>
        <span class="[display:flex] [flex-direction:column] [gap:5px]"><strong class="[font-size:15px] [line-height:1]">New quote request</strong><span class="[font-size:13px] [line-height:1] [color:#4A5675] [font-weight:600]">Roof inspection · just now</span></span>
      </div>
    </div>
  </div>
</section>
