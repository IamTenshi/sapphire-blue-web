---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { createSiteGraph, siteIdentity } from '../data/seo';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title = siteIdentity.title, description = siteIdentity.description, noindex: requestedNoindex = false } = Astro.props;
const noindex = requestedNoindex || import.meta.env.VERCEL_ENV === 'preview';
// Vercel's collection routes are not available in local dev or preview.
const enableObservability = import.meta.env.PROD && import.meta.env.VERCEL === '1';
const enableCustomEvents = enableObservability && import.meta.env.VERCEL_ENV === 'production' && import.meta.env.PUBLIC_ENABLE_CUSTOM_EVENTS === 'true';
const siteUrl = new URL('/', Astro.site).href;
// Never let campaign parameters or a preview host become the canonical URL.
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const socialImage = new URL('/social-preview-v2.jpg', siteUrl).href;
const socialTitle = title;
const socialDescription = description;
const socialImageAlt = 'Your whole online presence in one place. Sapphire Blue — sapphireblue.studio';
---
<!DOCTYPE html>
<html lang="en" data-custom-events={enableCustomEvents ? 'true' : undefined}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}>
{!noindex && <link rel="canonical" href={pageUrl}>}
<link rel="sitemap" type="application/xml" href={new URL('/sitemap.xml', siteUrl).href}>
<meta name="theme-color" content="#155DFC">
<meta property="og:site_name" content="sapphire blue.">
<meta property="og:title" content={socialTitle}>
<meta property="og:description" content={socialDescription}>
<meta property="og:type" content="website">
<meta property="og:locale" content="en_US">
<meta property="og:url" content={pageUrl}>
<meta property="og:image" content={socialImage}>
<meta property="og:image:secure_url" content={socialImage}>
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={socialImageAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={socialTitle}>
<meta name="twitter:description" content={socialDescription}>
<meta name="twitter:image" content={socialImage}>
<meta name="twitter:image:alt" content={socialImageAlt}>
<link rel="icon" type="image/svg+xml" href="/assets/sapphire-blue-logo.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png">
<link rel="manifest" href="/favicon/site.webmanifest">
<link rel="preload" href="/fonts/manrope-latin-wght-400-800.woff2" as="font" type="font/woff2" crossorigin>
{!noindex && Astro.url.pathname === '/' && <script type="application/ld+json" set:html={JSON.stringify(createSiteGraph(siteUrl)).replace(/</g, '\\u003c')} />}
</head>
<body>
  <a class="skip-link" href="#top">Skip to content</a>
  {enableObservability && <Analytics />}
  {enableObservability && <SpeedInsights />}
  <slot />
</body>
</html>
