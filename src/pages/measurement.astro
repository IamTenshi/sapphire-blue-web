---
// An inert, sandboxed measurement document, not an indexable public content page.
// It does nothing when opened directly, including without JavaScript.
const production = import.meta.env.PROD && import.meta.env.VERCEL === '1' && import.meta.env.VERCEL_ENV === 'production';
---
<!doctype html>
<html lang="en" data-production={production ? 'true' : 'false'}>
  <head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self' https://www.googletagmanager.com; connect-src https://www.facebook.com https://*.google-analytics.com https://*.analytics.google.com; img-src https://*.google-analytics.com; base-uri 'none'; form-action 'none'">
    <title>Optional measurement | Sapphire Blue</title>
  </head>
  <body><script is:inline src="/measurement-frame.js" referrerpolicy="no-referrer"></script></body>
</html>
